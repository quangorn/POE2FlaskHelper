<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Generated by CMakeLists configure_file from project(... VERSION) (S0-5):
     @PROJECT_VERSION@ is replaced with the project version, so bumping
     project(POE2FlaskHelper VERSION x.y.z) propagates to assemblyIdentity. The 4th
     manifest field is the revision (0), matching APP_VERSION_FULL in version.h.in. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="@PROJECT_VERSION@.0" name="POE2FlaskHelper.app" type="win32"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
